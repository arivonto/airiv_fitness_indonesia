<odoo>
    <record id="view_fitness_member_list" model="ir.ui.view">
        <field name="name">airiv.fitness.member.list</field>
        <field name="model">airiv.fitness.member</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="partner_id"/><field name="goal"/><field name="trainer_id"/><field name="wellness_score" widget="progressbar"/><field name="membership_end"/></list></field>
    </record>
    <record id="view_fitness_member_form" model="ir.ui.view">
        <field name="name">airiv.fitness.member.form</field>
        <field name="model">airiv.fitness.member</field>
        <field name="arch" type="xml"><form><header><button name="action_log_assessment" type="object" string="Log Energy Assessment" class="oe_highlight"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="partner_id"/><field name="trainer_id"/><field name="goal"/></group><group><field name="membership_plan_id"/><field name="membership_start"/><field name="membership_end"/></group></group><group string="VitalOS Snapshot"><field name="energy_level"/><field name="wellness_score" widget="progressbar"/></group><notebook><page string="Energy Assessments"><field name="assessment_ids"><list editable="bottom"><field name="date"/><field name="energy_level"/><field name="sleep_quality"/><field name="stress_level"/><field name="recommendation"/></list></field></page><page string="Progress Journey"><field name="progress_ids"><list editable="bottom"><field name="date"/><field name="weight"/><field name="body_fat"/><field name="waist"/><field name="workout_minutes"/></list></field></page></notebook></sheet></form></field>
    </record>
    <record id="view_fitness_trainer_list" model="ir.ui.view"><field name="name">airiv.fitness.trainer.list</field><field name="model">airiv.fitness.trainer</field><field name="arch" type="xml"><list><field name="name"/><field name="specialty"/><field name="member_count"/></list></field></record>
    <record id="view_fitness_plan_list" model="ir.ui.view"><field name="name">airiv.fitness.plan.list</field><field name="model">airiv.fitness.membership.plan</field><field name="arch" type="xml"><list><field name="name"/><field name="duration_days"/><field name="price"/></list></field></record>
    <record id="view_fitness_assessment_list" model="ir.ui.view"><field name="name">airiv.fitness.assessment.list</field><field name="model">airiv.fitness.assessment</field><field name="arch" type="xml"><list><field name="date"/><field name="member_id"/><field name="energy_level"/><field name="sleep_quality"/><field name="recommendation"/></list></field></record>
    <record id="action_fitness_members" model="ir.actions.act_window"><field name="name">Members</field><field name="res_model">airiv.fitness.member</field><field name="view_mode">list,form</field></record>
    <record id="action_fitness_trainers" model="ir.actions.act_window"><field name="name">Trainers</field><field name="res_model">airiv.fitness.trainer</field><field name="view_mode">list,form</field></record>
    <record id="action_fitness_plans" model="ir.actions.act_window"><field name="name">Membership Plans</field><field name="res_model">airiv.fitness.membership.plan</field><field name="view_mode">list,form</field></record>
    <record id="action_fitness_assessments" model="ir.actions.act_window"><field name="name">Energy Assessments</field><field name="res_model">airiv.fitness.assessment</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_fitness_root" name="AIRIV Active Wellness" action="airiv_os_core.action_airiv_launchpad_fitness" sequence="20"/>
    <menuitem id="menu_fitness_back_airiv_os" name="Back to AIRIV OS" parent="menu_fitness_root" action="airiv_os_core.action_airiv_os_home" sequence="1"/>
    <menuitem id="menu_fitness_members" name="Members" parent="menu_fitness_root" action="action_fitness_members" sequence="10"/>
    <menuitem id="menu_fitness_trainers" name="Trainers" parent="menu_fitness_root" action="action_fitness_trainers" sequence="20"/>
    <menuitem id="menu_fitness_assessments" name="Energy Assessments" parent="menu_fitness_root" action="action_fitness_assessments" sequence="30"/>
    <menuitem id="menu_fitness_plans" name="Membership Plans" parent="menu_fitness_root" action="action_fitness_plans" sequence="40"/>
</odoo>
